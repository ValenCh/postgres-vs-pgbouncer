# Copie este archivo a .env (cp .env.example .env) y cambie las contraseñas.
# Son credenciales LOCALES de laboratorio; los puertos solo se publican en 127.0.0.1.
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=cambiar_admin_local
POSTGRES_DB=bench
APP_CORE_PASSWORD=cambiar_core_local
APP_PORTAL_PASSWORD=cambiar_portal_local

# --- Recursos: perfil "paper" (necesita >= 9 CPU lógicas y ~8 GB para Docker) ---
PG_CPUS=4
PG_CPUSET=0-3
PG_MEM=4g
PGB_CPUS=1
PGB_CPUSET=4
PGB_MEM=512m
LG_CPUS=4
LG_CPUSET=5-8

# --- Recursos: perfil "reducido" (descomente y comente el bloque anterior) ---
# Equipos de 4 CPU lógicas: PostgreSQL 0-1, PgBouncer 2, generador 3.
# PG_CPUS=2
# PG_CPUSET=0-1
# PG_MEM=2g
# PGB_CPUS=1
# PGB_CPUSET=2
# PGB_MEM=512m
# LG_CPUS=1
# LG_CPUSET=3
# LG_CPUS/LG_CPUSET deben existir en la VM de Docker (docker info -> CPUs).

PG_HOST_PORT=5432
PGB_HOST_PORT=6432
